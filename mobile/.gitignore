# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
# dist/ — now tracked (build output kept in repo by request)
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit — held a Google client secret once; see .env.example)
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
# /android — now tracked; android/.gitignore still excludes build/ and .gradle

# Gradle output inside local Expo modules — /android above misses these,
# since the modules live outside the root native folders
modules/**/android/build/
modules/**/android/.cxx/

# Play Store service-account key (NEVER commit)
/credentials/
