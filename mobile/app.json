{
  "expo": {
    "name": "Quranic Clinic",
    "slug": "quranic-clinic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "quranicclinic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quranicclinic.dev",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.quranicclinic",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "quranicclinic",
              "host": "auth-callback"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "API_BASE_URL": "https://mashfa.odooclick.com/api",
      "router": {},
      "eas": {
        "projectId": "c44a0590-7866-4458-b3d0-e01e4a9ca4d8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/tone_chime.wav",
            "./assets/sounds/tone_bells.wav",
            "./assets/sounds/tone_dawn.wav",
            "./assets/sounds/tone_pulse.wav"
          ]
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quranic Clinic uses your location to calculate accurate prayer times for the automatic waking-adhkar reminder."
        }
      ],
      "expo-asset",
      "expo-screen-orientation",
      [
        "expo-image-picker",
        {
          "photosPermission": "Quranic Clinic needs access to your photos so you can set a profile picture."
        }
      ]
    ],
    "owner": "wael-hamwi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c44a0590-7866-4458-b3d0-e01e4a9ca4d8"
    }
  }
}
