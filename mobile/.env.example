# Copy to .env and fill in. NEVER commit .env — and NEVER put a client secret here:
# EXPO_PUBLIC_* vars are inlined into the app bundle. The Google client secret is
# server-side only (backend/.env).

# Google OAuth client IDs (public identifiers, safe to ship in the bundle)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- API base URL — TEST-MODE TOGGLE ------------------------------------------
# Flip between the two testing modes by (un)commenting EXPO_PUBLIC_API_URL below.
#
#   LOCAL mode      → COMMENT OUT EXPO_PUBLIC_API_URL. A dev run hits the local
#                     backend (LAN host auto-derived from the Expo dev server) and
#                     auto-falls back to Mashfa if local is down. Backend auth is
#                     lenient locally, so auth-gated bugs can stay hidden here.
#
#   PRODUCTION mode → UNCOMMENT EXPO_PUBLIC_API_URL. Forces Mashfa everywhere —
#                     even in Expo Go / dev client — so REAL auth is exercised.
#                     Required to verify auth-gated features before/after an APK
#                     build. This is a temporary test toggle, not a permanent
#                     setting (see CLAUDE.md rule).
#
# EXPO_PUBLIC_API_URL_LOCAL is only the web/fallback host — leave it as localhost.
EXPO_PUBLIC_API_URL_LOCAL=http://localhost:8000/api
# EXPO_PUBLIC_API_URL=https://mashfa.odooclick.com/api
