APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Scalability ───────────────────────────────────────────────────────────────
# Redis is OPTIONAL. Defaults above (database/file) work with no Redis installed.
# To enable Redis once it's running, flip these to `redis` (see DEPLOYMENT.md):
#   CACHE_STORE=redis
#   SESSION_DRIVER=redis
#   QUEUE_CONNECTION=redis
# If a redis driver is set but Redis is unreachable, the app auto-falls back to
# file/database (toggle with REDIS_AUTO_FALLBACK).
REDIS_AUTO_FALLBACK=true
SCALABILITY_CACHE_WARN=true

# Audio delivery. local = server disk (default); cloud = future S3/CDN (placeholder).
AUDIO_DRIVER=local
# Offload local audio to Nginx via X-Accel-Redirect (production only; needs Nginx config).
AUDIO_X_ACCEL=false
AUDIO_X_ACCEL_PREFIX=/__audio_internal
# AUDIO_CLOUD_BASE_URL=

# Disease search: use MySQL/MariaDB FULLTEXT instead of LIKE. Keep false until the
# FULLTEXT index migration has run (DEPLOYMENT.md). Falls back to LIKE automatically.
SEARCH_USE_FULLTEXT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
